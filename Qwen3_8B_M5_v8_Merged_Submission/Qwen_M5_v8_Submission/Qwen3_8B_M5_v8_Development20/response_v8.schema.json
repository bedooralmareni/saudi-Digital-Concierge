{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "2.0"
      ],
      "description": "Contract version."
    },
    "scenario_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Copy input scenario ID, or null for ordinary user requests."
    },
    "language": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ],
      "description": "Same language as original user request; names may retain recorded spelling."
    },
    "response_type": {
      "type": "string",
      "enum": [
        "recommendations",
        "itinerary",
        "information",
        "clarification"
      ],
      "description": "Must match user intent unless clarification blocks completion."
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "no_match",
        "coverage_gap",
        "insufficient_data",
        "needs_clarification",
        "conflicting"
      ],
      "description": "Outcome of the requested task, not a tool status."
    },
    "message": {
      "type": "string",
      "description": "Concise answer in user language; explain missing evidence and constraints."
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      },
      "description": "Flat options for recommendation requests; empty for a pure itinerary or clarification."
    },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "day_number": {
            "type": "integer",
            "description": "Sequential day number beginning at 1."
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD only if supplied or deterministically derived; otherwise null."
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            },
            "description": "Supported activities/events/dining or hotel in this day; may be empty."
          }
        },
        "required": [
          "day_number",
          "date",
          "items"
        ]
      },
      "description": "Day-by-day plan only if requested; otherwise empty."
    },
    "constraint_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "constraint": {
            "type": "string",
            "description": "One user constraint in the request language."
          },
          "result": {
            "type": "string",
            "enum": [
              "met",
              "unmet",
              "unknown"
            ],
            "description": "Unknown when data does not establish the constraint."
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Retrieved record ID"
            },
            "description": "Records supporting this assessment; empty if none."
          }
        },
        "required": [
          "constraint",
          "result",
          "evidence_ids"
        ]
      },
      "description": "One entry per material hard constraint, including unmet or unverifiable ones."
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recorded_hotel_price_sar": {
          "type": [
            "number",
            "null"
          ],
          "description": "One chosen hotel's historical recorded price, not a current quote or full stay total."
        },
        "hotel_price_snapshot_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source snapshot date when a hotel price is supplied."
        },
        "verified_trip_total_sar": {
          "type": [
            "number",
            "null"
          ],
          "description": "Only when all requested cost categories are known and units compatible; otherwise null."
        },
        "unknown_cost_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Unknown cost category"
          },
          "description": "List e.g. meals, transport, event tickets; empty when none are relevant."
        }
      },
      "required": [
        "recorded_hotel_price_sar",
        "hotel_price_snapshot_date",
        "verified_trip_total_sar",
        "unknown_cost_categories"
      ]
    },
    "clarifying_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Question"
      },
      "description": "Questions for missing or inconsistent inputs; empty if not needed."
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Limitation"
      },
      "description": "Missing coverage, stale event flag, historical hotel price, or other relevant uncertainty."
    },
    "clarification_target": {
      "enum": [
        null,
        "city",
        "budget",
        "dates",
        "guests"
      ]
    },
    "lookup": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "type": "string"
        },
        "field": {
          "enum": [
            "max_persons",
            "guest_rating",
            "star_rating",
            "breakfast_included",
            "free_cancellation",
            "genre",
            "rating",
            "categories",
            "average_rating",
            "rate_count",
            "is_family_allowed"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "record_id",
        "field",
        "value"
      ]
    },
    "issue_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "missing_city",
          "conflicting_budget",
          "no_match",
          "restaurant_coverage_gap",
          "unknown_field",
          "historical_hotel_price",
          "historical_event_dates"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "scenario_id",
    "language",
    "response_type",
    "status",
    "message",
    "recommendations",
    "days",
    "constraint_results",
    "costs",
    "clarifying_questions",
    "limitations",
    "clarification_target",
    "lookup",
    "issue_codes"
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "type": "string",
          "enum": [
            "hotel",
            "restaurant",
            "activity",
            "event"
          ],
          "description": "Record category."
        },
        "record_id": {
          "type": "string",
          "description": "Exact ID returned by the relevant tool/knowledge base."
        },
        "name": {
          "type": "string",
          "description": "Exact recorded name."
        },
        "city": {
          "type": "string",
          "description": "Recorded city, preserving source spelling."
        },
        "recorded_hotel_price_sar": {
          "type": [
            "number",
            "null"
          ],
          "description": "Historical price_sar for hotels only; null for other entities."
        },
        "hotel_price_snapshot_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Hotel snapshot YYYY-MM-DD, if a hotel price is reported; otherwise null."
        },
        "event_start_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Event start YYYY-MM-DD, for events only."
        },
        "event_end_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "Event end YYYY-MM-DD, for events only."
        },
        "reason": {
          "type": "string",
          "description": "Short user-language reason supported by the retrieved record."
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_persons": {
              "type": [
                "number",
                "null"
              ]
            },
            "guest_rating": {
              "type": [
                "number",
                "null"
              ]
            },
            "star_rating": {
              "type": [
                "number",
                "null"
              ]
            },
            "breakfast_included": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "free_cancellation": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "genre": {
              "type": [
                "string",
                "null"
              ]
            },
            "rating": {
              "type": [
                "number",
                "null"
              ]
            },
            "categories": {
              "type": [
                "string",
                "null"
              ]
            },
            "average_rating": {
              "type": [
                "number",
                "null"
              ]
            },
            "rate_count": {
              "type": [
                "number",
                "null"
              ]
            },
            "is_family_allowed": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "required": [
            "max_persons",
            "guest_rating",
            "star_rating",
            "breakfast_included",
            "free_cancellation",
            "genre",
            "rating",
            "categories",
            "average_rating",
            "rate_count",
            "is_family_allowed"
          ],
          "description": "Copy native source facts. Use null for irrelevant or unrecorded fields. Never infer facts."
        }
      },
      "required": [
        "entity_type",
        "record_id",
        "name",
        "city",
        "recorded_hotel_price_sar",
        "hotel_price_snapshot_date",
        "event_start_date",
        "event_end_date",
        "reason",
        "facts"
      ]
    }
  }
}